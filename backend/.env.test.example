# Copy to .env.test for local test runs.
# The database name MUST contain "analytics_admin_test" — vitest.setup.ts refuses
# to run otherwise, because the suite truncates every table between tests.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/analytics_admin_test?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/analytics_admin_test?schema=public
REDIS_URL=redis://localhost:6379
